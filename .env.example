# Where contact form messages and signup notices are sent.
CONTACT_EMAIL=hello@uuorganized.com

# Public site URL used in emails.
SITE_URL=https://uuorganized.com

# Gemini writes a draft only when you click Write it on Emails.
# Paid model is Gemini 3.5 Flash-Lite, the current low-cost model.
# Create a key in Google AI Studio, turn on billing, then paste it here and on Vercel.
# The name can be GEMINI_API_KEY or Gemini_API_Key.
GEMINI_API_KEY=

# Resend sends the checklist from Stormi J.
# In Resend, verify uuorganized.com, then paste the API key and from address here and on Vercel.
RESEND_API_KEY=
RESEND_FROM=Stormi J <hello@uuorganized.com>

# Lets the site publish a scheduled post when its time arrives. Set on Vercel.
CRON_SECRET=

# Admin login for adding products and Stormi J's social links. Change these before you deploy.
ADMIN_EMAIL=stormij@uuorganized.com
ADMIN_PASSWORD=
SESSION_SECRET=

# Vercel Blob stores the product catalog, uploaded pictures, and the email list.
# Create a Blob store in the Vercel project and paste the token here.
BLOB_READ_WRITE_TOKEN=

# Signs checklist links inside emails. Any long random string is fine.
DOWNLOAD_SECRET=

# Stripe Checkout for paid downloads on the Unhinged. Unfiltered. Organized account.
# Amazon and Etsy buttons stay on the products that still use those links.
STRIPE_ACCOUNT_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
